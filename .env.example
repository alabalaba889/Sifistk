# Public server origin used in links/redirects
SIFISTK_PUBLIC_ORIGIN=http://localhost:8787
PORT=8787
HOST=127.0.0.1

# Invitation gate
SIFISTK_INVITE_REQUIRED=true
SIFISTK_INVITE_MINUTES=60

# Never commit real secrets
SIFISTK_ADMIN_EMAIL=
SIFISTK_ADMIN_KEY=

# Optional production integrations
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
RESEND_API_KEY=
SIFISTK_EMAIL_FROM=

SIFISTK_VERSION=8.4.0
SIFISTK_EXTENSION_DOWNLOAD_URL=
