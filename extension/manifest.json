{
  "manifest_version": 3,
  "name": "Sifistk",
  "version": "8.4.0",
  "description": "Centro técnico Sifistk para diagnóstico, análise, contexto, sessões, preferências e conexão com o serviço oficial.",
  "minimum_chrome_version": "114",
  "action": {"default_title":"Abrir Sifistk","default_popup":"popup.html"},
  "background": {"service_worker":"background.js"},
  "permissions": ["storage","alarms","sidePanel","activeTab","scripting"],
  "optional_permissions": ["tabs","downloads","sessions","notifications","tabGroups"],
  "optional_host_permissions": ["http://*/*","https://*/*"],
  "side_panel": {"default_path":"sidepanel.html"},
  "options_page":"options.html",
  "commands": {
    "open-sifistk":{"suggested_key":{"default":"Ctrl+Shift+Y"},"description":"Abrir Sifistk"},
    "analyze-page":{"suggested_key":{"default":"Ctrl+Shift+U"},"description":"Analisar a página atual"},
    "capture-context":{"suggested_key":{"default":"Ctrl+Shift+C"},"description":"Capturar contexto técnico da página"}
  }
}