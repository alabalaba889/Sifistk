{
  "manifest_version": 3,
  "name": "Sifistk",
  "version": "10.1.0",
  "description": "Agente Sifistk com AI Core, orquestração multiagente e ferramentas autorizadas.",
  "minimum_chrome_version": "116",
  "action": {
    "default_title": "Abrir Sifistk"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "sidePanel",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost:8787/*",
    "http://127.0.0.1:8787/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "side_panel": {
    "default_path": "agent.html"
  }
}
